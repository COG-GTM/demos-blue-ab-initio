#=============================================================================
# Parameter Set: gmrd_daily.pset (SIT)
# JIRA: GMRD-212
# Description: SIT environment parameter set for the daily EOD batch.
#=============================================================================

ENV=sit
AB_SANDBOX=/data/gmrd/sit

TD_JDBC_URL=jdbc:teradata://TDSIT01/DATABASE=GMRD_CORE_DB,DBS_PORT=1025,CHARSET=UTF8,TMODE=ANSI
TD_USER=${AB_TD_SIT_USER}
TD_PASSWORD=${AB_TD_SIT_PASSWORD}

CALYPSO_JDBC_URL=jdbc:oracle:thin:@calypso-sit.internal:1521/CALSIT
CALYPSO_USER=${AB_CALYPSO_SIT_USER}
CALYPSO_PASSWORD=${AB_CALYPSO_SIT_PASSWORD}

MUREX_JDBC_URL=jdbc:sybase:Tds:murex-sit.internal:5000/MXDM
MUREX_USER=${AB_MUREX_SIT_USER}
MUREX_PASSWORD=${AB_MUREX_SIT_PASSWORD}

SUMMIT_JDBC_URL=jdbc:oracle:thin:@summit-sit.internal:1521/SMTSIT
SUMMIT_USER=${AB_SUMMIT_SIT_USER}
SUMMIT_PASSWORD=${AB_SUMMIT_SIT_PASSWORD}

BBG_FEED_DIR=/data/feeds/bloomberg/sit
RTR_FEED_DIR=/data/feeds/reuters/sit

OUTPUT_DIR=${AB_SANDBOX}/data/extract
EXTRACT_DIR=${AB_SANDBOX}/data/extract
INPUT_DIR=${AB_SANDBOX}/data/extract
LOOKUP_DIR=${AB_SANDBOX}/data/extract
REJECT_DIR=${AB_SANDBOX}/data/reject
ARCHIVE_DIR=${AB_SANDBOX}/data/archive
HIERARCHY_FILE=${AB_SANDBOX}/data/reference/corporate_hierarchy.dat

MAX_PARALLELISM=4
MAX_SESSIONS=8
FETCH_SIZE=10000
BATCH_SIZE=25000
STALE_PRICE_THRESHOLD_DAYS=3
STALE_THRESHOLD_PCT=0.001
OUTLIER_THRESHOLD_PCT=0.20

LOG_DIR=${AB_SANDBOX}/logs
LOG_LEVEL=INFO
